# WhatsApp Bot Configuration
# Path to store multi-file auth credentials
AUTH_DIR=./auth_info

# Log level: silent, trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Target Group JID (e.g. 120363xxxxxx@g.us) to monitor (leave blank to log all incoming messages or allow any group)
TARGET_GROUP_JID=

# Trigger suffix / mention (default: @protone)
TRIGGER_TAG=@protone

# Groq API Configuration
# Get your API Key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Maximum allowed requests per minute to stay safely within Groq rate limits (default: 25)
GROQ_RPM_LIMIT=25

# Tavily Search API Configuration (for real-time web search tool)
# Get your API Key from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

